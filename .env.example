# Ardur OSS RADAR engine — environment defaults
# Cost-guarded, pluggable AI provider. Default is the deterministic, zero-cost,
# zero-network path: the engine produces a complete, publishable radar cycle with
# no API key, no GitHub token, and no chatter fetches.

# --- AI provider (project writeups) ---------------------------------------
# Provider: deterministic | ollama | openai
ARDUR_AI_PROVIDER=deterministic
# Hard kill switch: 0 forces deterministic regardless of provider
ARDUR_AI_ENABLED=1
# Per-run generation budget; deterministic fallback after this many model calls
ARDUR_AI_MAX_GENERATIONS=20
# Per-call timeout (ms) before falling back
ARDUR_AI_TIMEOUT_MS=20000

# Ollama (local-first; cloud only if OLLAMA_API_KEY is set)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1
# OLLAMA_API_KEY=

# OpenAI (optional)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- GitHub ingestion ------------------------------------------------------
# Token raises the Search API rate limit (10/min anon -> 30/min authed).
# GITHUB_TOKEN=
# GH_TOKEN=
# Pause between GitHub Search queries (ms) to stay under the rate limit.
ARDUR_GITHUB_SEARCH_DELAY_MS=0

# --- Chatter adapters (off by default => deterministic builds) -------------
# Each flag opts a single platform into live network fetches.
ARDUR_OSS_FETCH_HN=0
ARDUR_OSS_FETCH_REDDIT=0
ARDUR_OSS_FETCH_DEVTO=0
ARDUR_OSS_FETCH_MEDIUM=0
ARDUR_OSS_FETCH_YOUTUBE=0
ARDUR_OSS_FETCH_X=0
# Chatter API keys (only used when the matching flag is 1)
# YOUTUBE_API_KEY=
# X_API_BEARER_TOKEN=
